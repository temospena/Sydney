FROM eclipse-temurin:21-jre

WORKDIR /brouter

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 17777

# BRouter jar and segments are mounted via docker-compose volumes.
# Usage: RouteServer <segmentdir> <profiledir> <customprofiledir> <port> <maxthreads> [bindaddress]
ENTRYPOINT ["/entrypoint.sh"]
