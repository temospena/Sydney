---context:global

assign validForBikes = true
assign validForCars  = false
assign validForFoot  = false

assign isbike = true

---context:node
assign initialcost = 0
assign turncost    = 0

---context:way

assign switchpoint = false

# ---------------------------------------------------------------------------
# Ferry penalty — route=ferry links are very undesirable for cycling routing
# (they inflate circuity and duration unrealistically)
# ---------------------------------------------------------------------------
assign is_ferry = route=ferry

# ---------------------------------------------------------------------------
# Baseline cost by highway type — all values >= 1.0
# cycleway = 1.0 is the reference (best possible road).
# Gaps are moderate: residential 30% more costly than cycleway,
# primary 3× more costly. This gives realistic circuity (1.1–1.5).
# ---------------------------------------------------------------------------
assign hm =
  if ( highway=cycleway                                            ) then 1.0
  else if ( highway=path|track                                     ) then 1.1
  else if ( highway=service                                        ) then 1.15
  else if ( highway=residential|living_street|unclassified         ) then 1.3
  else if ( highway=pedestrian                                     ) then 1.4
  else if ( highway=tertiary|tertiary_link                         ) then 1.5
  else if ( highway=secondary|secondary_link                       ) then 1.8
  else if ( highway=primary|primary_link                           ) then 3.0
  else if ( highway=footway                                        ) then 2.5
  else if ( highway=steps                                          ) then 6.0
  else if ( highway=motorway|motorway_link|trunk|trunk_link        ) then 9999.0
  else 2.0

# ---------------------------------------------------------------------------
# CI infrastructure overrides — always >= 1.0
# ---------------------------------------------------------------------------

# Protected / separated track (strong_ci) → best = same as open cycleway
assign has_track =
  or highway=cycleway
     or cycleway=track
        or cycleway=opposite_track
           or cycleway:right=track
              cycleway:left=track

# Painted cycle lane (moderate_ci) → 10% bonus over residential
assign has_lane =
  or cycleway=lane
     or cycleway=opposite_lane
        or cycleway:right=lane
           or cycleway:left=lane
              or cycleway:right=opposite_lane
                 cycleway:left=opposite_lane

# Shared lane / busway (weak_ci) → marginal bonus
assign has_weak =
  or cycleway=shared_lane
     cycleway=share_busway

# Cycling on pedestrian infra (shared_foot) — neutral/slight bonus
assign has_foot =
  and highway=path|footway|pedestrian
      bicycle=yes|designated

# ---------------------------------------------------------------------------
# Final costfactor: all values >= 1.0 so circuity is always >= 1
# ---------------------------------------------------------------------------
assign hw =
  if ( is_ferry  ) then 999.0
  else if ( has_track ) then 1.0
  else if ( has_lane  ) then 1.1
  else if ( has_weak  ) then 1.2
  else if ( has_foot  ) then 1.3
  else hm

assign costfactor = hw
