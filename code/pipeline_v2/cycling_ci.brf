---context:global

assign validForBikes = true
assign validForCars  = false
assign validForFoot  = false

assign isbike = true

---context:node
assign initialcost = 0
assign turncost    = 0

---context:way

assign switchpoint = false

# ---------------------------------------------------------------------------
# Baseline cost by highway type (cost per metre, without CI bonus)
# Reference: BRouter fastbike.brf style — keep gaps small so circuity stays
# realistic (target avg_circuity ~1.1-1.4 for a typical city).
# A residential road at 1.2 vs cycleway at 0.8 = 50% preference for cycleway,
# not 10x which would cause extreme detours and inflated circuity.
# ---------------------------------------------------------------------------
assign hm =
  if ( highway=cycleway         ) then 0.8
  else if ( highway=path|track|service         ) then 1.0
  else if ( highway=residential|living_street|unclassified ) then 1.2
  else if ( highway=pedestrian  ) then 1.3
  else if ( highway=tertiary|tertiary_link    ) then 1.4
  else if ( highway=secondary|secondary_link  ) then 1.7
  else if ( highway=primary|primary_link      ) then 2.2
  else if ( highway=footway     ) then 2.5
  else if ( highway=steps       ) then 5.0
  else if ( highway=motorway|motorway_link|trunk|trunk_link ) then 9999.0
  else 2.0

# ---------------------------------------------------------------------------
# CI infrastructure overrides (small bonus on top of the highway baseline)
# ---------------------------------------------------------------------------

# Protected / separated track (strong_ci) → best bonus
assign has_track =
  or highway=cycleway
     or cycleway=track
        or cycleway=opposite_track
           or cycleway:right=track
              cycleway:left=track

# Painted cycle lane (moderate_ci) → modest bonus
assign has_lane =
  or cycleway=lane
     or cycleway=opposite_lane
        or cycleway:right=lane
           or cycleway:left=lane
              or cycleway:right=opposite_lane
                 cycleway:left=opposite_lane

# Shared lane / busway (weak_ci) → small bonus
assign has_weak =
  or cycleway=shared_lane
     cycleway=share_busway

# Cycling on pedestrian infra (shared_foot)
assign has_foot =
  and highway=path|footway|pedestrian
      bicycle=yes|designated

# ---------------------------------------------------------------------------
# Final costfactor: use CI bonus where available, otherwise use hm
# Bonuses are additive reductions, keeping gaps moderate not extreme.
# ---------------------------------------------------------------------------
assign hw =
  if ( has_track ) then 0.8
  else if ( has_lane  ) then 0.9
  else if ( has_weak  ) then 1.0
  else if ( has_foot  ) then 1.2
  else hm

assign costfactor = hw


